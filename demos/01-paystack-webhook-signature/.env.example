# Copy to .env.local and fill in TEST values only. Never commit .env.local.

# Webhook signing secret: Paystack dashboard > Developers > API configuration (starts with whsec_)
PAYSTACK_WEBHOOK_SECRET=whsec_replace_me

# Test secret key (starts with sk_test_). Only used for the legacy x-paystack-signature check.
PAYSTACK_SECRET_KEY=sk_test_replace_me

# Accept the old x-paystack-signature when the new header is missing.
# Turn OFF once your events carry Paystack-Signature.
ALLOW_LEGACY_SIGNATURE=true
